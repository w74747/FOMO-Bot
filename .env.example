PORT=8080
LOG_LEVEL=INFO

# Redis & Postgres
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/fomo_engine

# FOMO API
FOMO_API_BASE=https://fomoapi.io/api/v1
FOMO_API_KEY=your_fomo_api_key

# Telegram Telethon Session (Controller Userbot)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_STRING_SESSION=your_generated_telethon_string_session
TARGET_BOT_USERNAME=@DawnTradeBot

# Telegram Control Bot (Alerts & Interface)
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvwxyZ
ALLOWED_ADMIN_CHAT_ID=987654321

# Optional Grok / xAI
XAI_API_KEY=xai-your-api-key-optional
ENABLE_GROK_AUDIT=false
